{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "verbatimModuleSyntax": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "$lib": [
        "./src/lib"
      ],
      "$lib/*": [
        "./src/lib/*"
      ]
    }
  },
  "include": [
    "src",
    "test-catalogs/base/saturn.json",
    "*.ts"
  ],
  "references": [
    {
      "path": "../../packages/control"
    },
    {
      "path": "../../packages/cspice-wasm"
    },
    {
      "path": "../../packages/frames"
    },
    {
      "path": "../../packages/spice"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/three"
    }
  ]
}
