# Loaded by `vite dev` only; production builds never see it. The viewer lists
# no catalog sources unless configured (docs/catalog-sources.md), so local
# development opts into the repository's examples here, the same way the
# Pages workflow does for the public site. Override in .env.development.local.
VITE_CATALOG_SOURCES='[{"id":"examples","name":"Examples","indexUrl":"index.json"}]'
