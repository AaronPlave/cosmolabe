{
  "name": "@cosmolabe/viewer",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Cosmolabe Viewer — space mission visualization: the standalone app, and the same workspace as an embeddable ES module (dist-embed)",
  "author": "Aaron Plave",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AaronPlave/cosmolabe.git",
    "directory": "apps/viewer"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist-embed/cosmolabe.d.ts",
      "import": "./dist-embed/cosmolabe.js"
    }
  },
  "files": [
    "dist-embed"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:svelte": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --output human",
    "test:visual": "node ../../scripts/visual-regression.mjs",
    "test:visual:update": "UPDATE_VISUAL_GOLDENS=1 node ../../scripts/visual-regression.mjs",
    "build:embed": "vite build -c vite.embed.config.ts && rollup -c rollup.dts.config.mjs"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@cosmolabe/control": "*",
    "@cosmolabe/core": "*",
    "@cosmolabe/frames": "*",
    "@cosmolabe/three": "*",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.8.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "bits-ui": "^2.18.0",
    "clsx": "^2.1.1",
    "cspice-wasm": "*",
    "lucide-svelte": "^1.0.1",
    "pixelmatch": "^6.0.0",
    "playwright": "^1.49.0",
    "pngjs": "^7.0.0",
    "rollup-plugin-dts": "^6.5.1",
    "svelte": "^5.33.0",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "three": "^0.183.2",
    "vite": "^7.3.1"
  }
}
