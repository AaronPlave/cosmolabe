# Cesium Ion API token. Required for Mars terrain (Cesium Mars asset 3644333)
# and any other catalog terrain block of type "cesium-ion".
#
# Get a token (free Community tier is enough for development):
#   1. Sign up at https://ion.cesium.com/signup/
#   2. Visit https://ion.cesium.com/tokens
#   3. Copy the "Default Token" or create a new one with `assets:read` scope
#   4. Copy this file to .env.local and paste the token below
#
# .env.local is gitignored by Vite — your token won't be committed.
VITE_CESIUM_ION_TOKEN=

# Catalog sources the welcome screen lists (docs/catalog-sources.md). A JSON
# array of { id, name, indexUrl }; relative indexUrls resolve against the
# viewer's base URL. Unset or `[]` lists none; dropped files and
# ?catalog=<name> still work. `npm run dev` lists the repository's examples
# via .env.development.
# VITE_CATALOG_SOURCES=[{"id":"mission","name":"My Mission","indexUrl":"/catalogs/index.json"}]

# Let visitors add sources at runtime with ?source=<indexUrl> (repeatable).
# VITE_ALLOW_CATALOG_SOURCE_PARAM=true
