{
  "name": "Earth daily imagery (GIBS)",
  "version": "1.1",
  "description": "Time-indexed streamed imagery pilot (#214): a static Earth map, streamed Blue Marble, and a NASA GIBS MODIS daily true-colour layer whose acquisition date follows simulation time, or is fixed from the Imagery section. See docs/time-indexed-imagery.md for what the image shows, its cadence, gaps and the test script.",
  "defaultTime": "2024-06-01T18:00:00Z",
  "defaultViewpoint": "Earth from orbit",
  "items": [
    {
      "name": "Earth from orbit",
      "type": "Viewpoint",
      "center": "Earth",
      "distance": 16000,
      "latitude": 20,
      "longitude": -100
    },
    {
      "name": "Regional close-up",
      "type": "Viewpoint",
      "center": "Earth",
      "distance": 6900,
      "latitude": 36.5,
      "longitude": -121.5
    },
    {
      "name": "Track ISS",
      "type": "Viewpoint",
      "center": "ISS",
      "distance": 10,
      "latitude": 15,
      "longitude": 0
    },
    {
      "name": "Sun",
      "class": "star",
      "trajectory": {
        "type": "FixedPoint",
        "position": [
          0,
          0,
          0
        ]
      },
      "geometry": {
        "type": "Globe",
        "radius": 695000
      },
      "label": {
        "color": [
          1.0,
          0.9,
          0.3
        ]
      }
    },
    {
      "name": "Earth",
      "class": "planet",
      "center": "Sun",
      "trajectory": {
        "type": "Builtin",
        "name": "Earth"
      },
      "rotationModel": {
        "type": "Builtin"
      },
      "geometry": {
        "type": "Globe",
        "radii": [
          6378.137,
          6378.137,
          6356.752
        ],
        "baseMap": "textures/earth-5k.jpg",
        "atmosphere": "Earth",
        "imagery": [
          {
            "id": "blue-marble",
            "name": "Blue Marble",
            "description": "Blue Marble Shaded Relief and Bathymetry: a static composite with no acquisition date",
            "attribution": "NASA GIBS",
            "url": "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/BlueMarble_ShadedRelief_Bathymetry/default/GoogleMapsCompatible_Level8/{z}/{y}/{x}.jpeg",
            "levels": 8,
            "projection": "EPSG:3857"
          },
          {
            "id": "modis-daily",
            "name": "MODIS daily true colour",
            "description": "MODIS Terra corrected reflectance, true colour: one composite per UTC day of what the sensor saw that day, clouds included",
            "attribution": "NASA GIBS \u00b7 MODIS Terra",
            "resolutionMeters": 250,
            "url": "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/MODIS_Terra_CorrectedReflectance_TrueColor/default/2024-06-01/GoogleMapsCompatible_Level9/{z}/{y}/{x}.jpeg",
            "levels": 9,
            "projection": "EPSG:3857",
            "temporal": {
              "semantics": "acquisition",
              "cadence": "day",
              "policy": "follow-simulation",
              "start": "2000-02-24",
              "end": "present",
              "latencyDays": 1,
              "outOfRange": "hide",
              "illumination": "baked"
            }
          },
          {
            "id": "modis-daily-provider",
            "name": "MODIS daily (provider range)",
            "description": "The same product through the WMTS capabilities document (about 6 MB, fetched only when this layer is switched on): the first day, the last day and the gaps in between come from the provider, and Latest available is possible",
            "attribution": "NASA GIBS \u00b7 MODIS Terra",
            "resolutionMeters": 250,
            "type": "wmts-capabilities",
            "url": "https://gibs.earthdata.nasa.gov/wmts/epsg3857/best/wmts.cgi?SERVICE=WMTS&request=GetCapabilities",
            "layer": "MODIS_Terra_CorrectedReflectance_TrueColor",
            "tileMatrixSet": "GoogleMapsCompatible_Level9",
            "visible": false,
            "temporal": {
              "semantics": "acquisition",
              "cadence": "day",
              "policy": "follow-simulation",
              "latencyDays": 1,
              "outOfRange": "hide",
              "illumination": "baked"
            }
          }
        ]
      },
      "label": {
        "color": [
          0.4,
          0.6,
          1.0
        ]
      },
      "items": [
        {
          "name": "ISS",
