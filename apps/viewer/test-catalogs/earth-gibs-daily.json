          },
          "label": {
            "color": [
              1.0,
              1.0,
              1.0
            ]
          },
          "trajectoryPlot": {
            "color": "#ffcc00",
            "fade": 0.5,
            "duration": "1.5h",
            "visible": true
          }
        }
      ]
    }
  ]
}
